# Site URL (e.g. https://example.com). Defaults to http://localhost:3000
NUXT_PUBLIC_SITE_URL=

# Site base URL (e.g. / for root, /my-app/ for subpath). Defaults to /markdown-resume/
NUXT_APP_BASE_URL=

# Google Fonts Developer API key (enables the Google Fonts picker)
NUXT_PUBLIC_GOOGLE_FONTS_KEY=
